TabBoosts:CreateToggle({
   Name = "🔄 ТП ФАРМ (Телепорт по бустам)",
   CurrentValue = false,
   Callback = function(value)
      boostActive = value
      if boostActive then
         print("✅ ТП-фарм запущен!")
         task.spawn(FarmBoosts)
         Rayfield:Notify({ Title = "ТП Фарм", Content = "Запущен!", Duration = 2 })
      else
         print("🛑 ТП-фарм остановлен!")
         Rayfield:Notify({ Title = "ТП Фарм", Content = "Остановлен!", Duration = 2 })
      end
   end,
})

TabBoosts:CreateToggle({
   Name = "📦 АВТО-СБОР БУСТОВ (Сбор + клик)",
   CurrentValue = false,
   Callback = function(value)
      collectActive = value
      if collectActive then
         print("✅ Авто-сбор бустов запущен!")
         task.spawn(AutoCollectBoosts)
         Rayfield:Notify({ Title = "Авто-сбор", Content = "Запущен!", Duration = 2 })
      else
         print("🛑 Авто-сбор бустов остановлен!")
         Rayfield:Notify({ Title = "Авто-сбор", Content = "Остановлен!", Duration = 2 })
      end
   end,
})

TabBoosts:CreateButton({
   Name = "💎 Собрать буст вручную (ближайший)",
   Callback = function()
      local char = localPlayer.Character
      if char then
         local root = char:FindFirstChild("HumanoidRootPart")
         if root then
            local nearest = nil
            local nearestDist = 100

            local boostsFolder = Workspace:FindFirstChild("Map")
            if boostsFolder then
               boostsFolder = boostsFolder:FindFirstChild("Boosts")
            end

            if boostsFolder then
               for _, obj in pairs(boostsFolder:GetDescendants()) do
                  if obj:IsA("BasePart") and obj.Name:find("Boost") then
                     local dist = (obj.Position - root.Position).Magnitude
                     if dist < nearestDist then
                        nearestDist = dist
                        nearest = obj
                     end
                  end
               end
            end

            if nearest then
               root.CFrame = nearest.CFrame + Vector3.new(0, 2, 0)
               task.wait(0.2)
               CollectBoost(nearest)
               Rayfield:Notify({ Title = "Сбор", Content = "Буст собран!", Duration = 2 })
               print("✅ Ближайший буст собран!")
            else
               Rayfield:Notify({ Title = "Ошибка", Content = "Бусты не найдены!", Duration = 2 })
               print("❌ Бусты не найдены!")
            end
         end
      end
   end,
})

TabBoosts:CreateInput({
   Name = "⏱️ Задержка между бустами (сек)",
   Placeholder = "0.1",
   Callback = function(v)
      collectDelay = tonumber(v) or 0.1
      print("⏱️ Задержка установлена: " .. collectDelay .. " сек")
      Rayfield:Notify({ Title = "Настройка", Content = "Задержка: " .. collectDelay .. " сек", Duration = 2 })
   end,
})

