-- Загрузка библиотеки Rayfield
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")
local localPlayer = Players.LocalPlayer

local Window = Rayfield:CreateWindow({
   Name = "Make an Army | Базы + Охота + Бусты",
   LoadingTitle = "Загрузка скрипта...",
   LoadingSubtitle = "Red vs Blue Ultimate",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false,
})

-- Создаем вкладки
local TabBases = Window:CreateTab("Базы", 4483362458)
local TabHunter = Window:CreateTab("Охота", 4483362458)
local TabBoosts = Window:CreateTab("Бусты", 4483362458)  -- Новая вкладка

-- Координаты баз (на 24 блока ниже для идеальной фиксации под текстурами)
local redBase = Vector3.new(42, -24, 425)
local blueBase = Vector3.new(40, -24, -390)

-- Переменные для охоты
local targetPlayer = nil
local hunting = false

-- Переменные для бустов
local boostActive = false
local collectActive = false
local collectDelay = 0.1

-- Функция безопасной телепортации
local function teleportUnder(pos)
   if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
      local root = localPlayer.Character.HumanoidRootPart
      root.CFrame = CFrame.new(pos)
      root.Anchored = true -- Фиксируем под картой
   end
end

-- ============================================
--  📦 ФУНКЦИЯ СБОРА БУСТА
-- ============================================
local function CollectBoost(part)
    pcall(function()
        -- Способ 1: Нажатие клавиши E
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)

        -- Способ 2: Клик по бусту
        local click = part:FindFirstChild("ClickDetector")
        if click then
            click:Click()
        end

        -- Способ 3: RemoteEvent
        local collectRemote = ReplicatedStorage:FindFirstChild("Remotes"):FindFirstChild("CollectBoost")
        if collectRemote then
            collectRemote:FireServer(part)
        end

        -- Способ 4: Обновление значения
        local boostValue = part:FindFirstChild("BoostValue")
        if boostValue then
            boostValue.Value = true
        end
    end)
end

-- ============================================
--  🔄 АВТО-СБОР БУСТОВ
-- ============================================
local function AutoCollectBoosts()
    print("📦 Запуск авто-сбора бустов...")

    while collectActive do
        local boostsFolder = Workspace:FindFirstChild("Map")
        if boostsFolder then
            boostsFolder = boostsFolder:FindFirstChild("Boosts")
        end

        if not boostsFolder then
            print("❌ Папка Boosts не найдена!")
            collectActive = false
            break
        end

        local boostParts = {}
        for _, obj in pairs(boostsFolder:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name:find("Boost") then
                table.insert(boostParts, obj)
            end
        end

        if #boostParts == 0 then
            print("❌ Бусты не найдены!")
            collectActive = false
            break
        end

        print("💎 Найдено бустов: " .. #boostParts)

        for _, part in pairs(boostParts) do
            if not collectActive then break end

            -- Телепорт к бусту
            local char = localPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = part.CFrame + Vector3.new(0, 2, 0)
                task.wait(0.1)
            end

            -- Сбор буста
            CollectBoost(part)
            task.wait(collectDelay)
        end

        task.wait(0.5)
    end
end

-- ============================================
--  🔄 ФАРМ БУСТОВ (ТЕЛЕПОРТЫ)
-- ============================================
local function FarmBoosts()
    print("💎 Запуск фарма бустов...")

    while boostActive do
        local boostsFolder = Workspace:FindFirstChild("Map")
        if boostsFolder then
            boostsFolder = boostsFolder:FindFirstChild("Boosts")
        end

        if not boostsFolder then
            print("❌ Папка Boosts не найдена!")
            boostActive = false
            break
        end

        local boostParts = {}
        for _, obj in pairs(boostsFolder:GetDescendants()) do
            if obj:IsA("BasePart") then
                table.insert(boostParts, obj)
            end
        end

        if #boostParts == 0 then
            print("❌ Бусты не найдены!")
            boostActive = false
            break
        end

        print("💎 Найдено бустов: " .. #boostParts)

        for _, part in pairs(boostParts) do
            if not boostActive then break end

            local char = localPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = part.CFrame + Vector3.new(0, 3, 0)
                print("📍 ТП к бусту: " .. part.Name)
            end

            task.wait(0.000000001)
        end

        task.wait(0.000000001)
    end
end

